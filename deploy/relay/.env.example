# Copy to .env next to docker-compose.yml and fill in.

# Hostname members dial (a DNS A record must point it at this server).
# vbank.localhost.co.zm is the relay every copy of the app knows about.
VBANK_RELAY_PUBLIC_HOST=vbank.localhost.co.zm

# Fixed identity: 32 random bytes, base64. Generate ONCE with
#   openssl rand -base64 32
# and keep it safe — it determines the /p2p/… part of the address that is
# published in DNS. Losing it means publishing a new TXT record.
VBANK_RELAY_IDENTITY_SEED=

# Only if you have no DNS name: members get a plain /ip4/ address instead.
# VBANK_RELAY_PUBLIC_IP=203.0.113.7
